# ── Core ────────────────────────────────────────────────────────────────
# ฐานข้อมูล = Cloudflare D1 (binding: DB) และไฟล์เพลง = Cloudflare R2 (binding: FILES)
# ทั้งสองอย่างผูกให้อัตโนมัติเมื่อดีพลอยขึ้น Freebuff Sites / รันด้วย wrangler dev
# ไม่มีตัวแปร path ในเครื่องอีกต่อไป

# ความลับสำหรับ session cookie
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=newgamer-145278-jjzkuy-5680-socket
# URL สาธารณะของเว็บ
APP_URL=http://localhost:3000

# ── บัญชีแอดมินสูงสุด (สร้าง/ซิงก์รหัสผ่านอัตโนมัติทุกครั้งที่รัน) ──────────
# ถ้าเปลี่ยน ADMIN_BOOTSTRAP_PASSWORD แล้วรีสตาร์ท ระบบจะตั้งรหัสผ่านใหม่ให้บัญชีนี้
ADMIN_EMAIL=noppasitdeelert@gmail.com
ADMIN_NAME=Noppasit Deelert
ADMIN_NICKNAME=Admin
ADMIN_BOOTSTRAP_PASSWORD=change-me

# ── ห้องประชุมวิดีโอ (Jitsi) ────────────────────────────────────────────
JITSI_DOMAIN=meet.jit.si

# ── เพลง (ไม่บังคับ) ───────────────────────────────────────────────────
# ชื่อแอปที่ส่งให้ Audius API (ใช้ค้นหา/สตรีมเพลงเต็มของศิลปินอิสระ)
AUDIUS_APP_NAME=SKC105 Room Hub

# ── Webhook แจ้งเตือนเริ่มต้น (ไม่บังคับ) ────────────────────────────────
# เพิ่ม/แก้ Webhook ได้สูงสุด 50 รายการที่หน้า /admin → แท็บ “API & Webhook”
DISCORD_WEBHOOK_URL=
LINE_WEBHOOK_URL=

# ── ค้นหาเว็บด้วย Exa (ไม่บังคับ) ────────────────────────────────────────
EXA_API_KEY=
